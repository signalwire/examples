{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "transitiveRemediation": true,
  "packageRules": [
    {
      "description": "Security-only onboarding: suppress routine version bumps; vulnerabilityAlerts still fire (they override this).",
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ]
}
